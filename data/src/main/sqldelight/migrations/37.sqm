-- Novel categories: novels are manga entries (with a NovelSource) but get their own category space.
CREATE TABLE novel_categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    hidden INTEGER NOT NULL DEFAULT 0
);

INSERT OR IGNORE INTO novel_categories(_id, name, sort, flags) VALUES (0, "", -1, 0);

CREATE TRIGGER IF NOT EXISTS system_novel_category_delete_trigger BEFORE DELETE
ON novel_categories
BEGIN SELECT CASE
    WHEN old._id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

CREATE TABLE mangas_novel_categories(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    manga_id INTEGER NOT NULL,
    novel_category_id INTEGER NOT NULL,
    FOREIGN KEY(novel_category_id) REFERENCES novel_categories (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);
